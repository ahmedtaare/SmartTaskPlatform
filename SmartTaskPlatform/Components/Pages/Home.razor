@page "/"
@using SmartTaskPlatform.Models
@using SmartTaskPlatform.Services
@inject TaskApiService Api

<PageTitle>SmartTask | Dashboard</PageTitle>

<div class="dashboard">

    <header class="dashboard-header">
        <div>
            <span class="eyebrow">WORKSPACE</span>
            <h1>My Tasks</h1>
            <p>Organize your work. Focus on what matters.</p>
        </div>

        <div class="header-mark">ST</div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="app-toast success-toast" role="status">
            <span class="toast-icon">✓</span>
            <span>@successMessage</span>
            <button class="toast-close"
                    aria-label="Dismiss message"
                    @onclick="DismissSuccess">
                ×
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="app-toast error-toast" role="alert">
            <span class="toast-icon">!</span>
            <span>@errorMessage</span>
            <button class="toast-close"
                    aria-label="Dismiss error"
                    @onclick="DismissError">
                ×
            </button>
        </div>
    }

    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon total-icon">☷</div>
            <div>
                <p>Total tasks</p>
                <h2>@tasks.Count</h2>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon pending-icon">◷</div>
            <div>
                <p>Pending</p>
                <h2>@tasks.Count(t => !t.IsCompleted)</h2>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon completed-icon">✓</div>
            <div>
                <p>Completed</p>
                <h2>@tasks.Count(t => t.IsCompleted)</h2>
            </div>
        </div>
    </section>

    <section class="task-panel">
        <div class="section-heading">
            <div>
                <h3>Create a task</h3>
                <p>Add a task and choose its priority.</p>
            </div>
            <span class="section-symbol">＋</span>
        </div>

        <form @onsubmit="AddTask" @onsubmit:preventDefault>
            <div class="create-form">
                <div class="title-field">
                    <label for="taskTitle">Task title</label>
                    <input id="taskTitle"
                           class="form-control"
                           placeholder="What do you need to do?"
                           maxlength="100"
                           @bind="newTitle" />
                </div>

                <div class="priority-field">
                    <label for="priority">Priority</label>
                    <select id="priority"
                            class="form-select"
                            @bind="newPriority">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <button type="submit"
                        class="btn btn-create"
                        disabled="@isBusy">
                    @(isBusy ? "Please wait..." : "+ Add Task")
                </button>
            </div>
        </form>
    </section>

    <section class="task-panel task-list-panel">
        <div class="section-heading">
            <div>
                <h3>Your tasks</h3>
                <p>Keep track of what needs to get done.</p>
            </div>

            <div class="api-status">
                <span class="api-dot @(apiConnected ? "api-online" : "api-offline")"></span>
                @(apiConnected ? "API Connected" : "API Unavailable")
            </div>
        </div>

        <div class="task-filters">
            <button class="filter-btn @(activeFilter == "All" ? "filter-active" : "")"
                    @onclick='() => SetFilter("All")'>
                All <span>@tasks.Count</span>
            </button>

            <button class="filter-btn @(activeFilter == "Pending" ? "filter-active" : "")"
                    @onclick='() => SetFilter("Pending")'>
                Pending <span>@tasks.Count(t => !t.IsCompleted)</span>
            </button>

            <button class="filter-btn @(activeFilter == "Completed" ? "filter-active" : "")"
                    @onclick='() => SetFilter("Completed")'>
                Completed <span>@tasks.Count(t => t.IsCompleted)</span>
            </button>
        </div>

        @if (isLoading)
        {
            <div class="empty-state">
                <div class="loading-spinner"></div>
                <p>Loading your tasks...</p>
            </div>
        }
        else if (tasks.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">☷</div>
                <h4>No tasks yet</h4>
                <p>Create your first task above to get started.</p>
            </div>
        }
        else
        {
            <div class="task-list">
                @foreach (var task in FilteredTasks)
                {
                    <article class="task-row" @key="task.Id">

                        @if (editingTaskId == task.Id)
                        {
                            <div class="edit-form">
                                <div class="edit-fields">
                                    <div>
                                        <label for="editTitle-@task.Id">Task title</label>
                                        <input id="editTitle-@task.Id"
                                               class="form-control"
                                               maxlength="100"
                                               @bind="editTitle" />
                                    </div>

                                    <div>
                                        <label for="editPriority-@task.Id">Priority</label>
                                        <select id="editPriority-@task.Id"
                                                class="form-select"
                                                @bind="editPriority">
                                            <option value="Low">Low</option>
                                            <option value="Medium">Medium</option>
                                            <option value="High">High</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="task-actions">
                                    <button class="btn btn-sm btn-create"
                                            disabled="@isBusy"
                                            @onclick="() => SaveEdit(task)">
                                        Save changes
                                    </button>

                                    <button class="btn btn-sm btn-light"
                                            disabled="@isBusy"
                                            @onclick="CancelEdit">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="completion-button @(task.IsCompleted ? "is-checked" : "")"
                                    title="@(task.IsCompleted ? "Mark as pending" : "Mark as completed")"
                                    aria-label="@(task.IsCompleted ? "Mark as pending" : "Mark as completed")"
                                    disabled="@isBusy"
                                    @onclick="() => ToggleComplete(task)">
                                @(task.IsCompleted ? "✓" : "")
                            </button>

                            <div class="task-content">
                                <div class="task-title @(task.IsCompleted ? "task-done" : "")">
                                    @task.Title
                                </div>

                                <div class="task-meta">
                                    <span class="priority-badge @GetPriorityClass(task.Priority)">
                                        @task.Priority priority
                                    </span>

                                    <span class="status-text @(task.IsCompleted ? "status-done" : "status-pending")">
                                        @(task.IsCompleted ? "Completed" : "Pending")
                                    </span>
                                </div>
                            </div>

                            <div class="task-actions">
                                <button class="btn btn-sm btn-edit"
                                        disabled="@isBusy"
                                        @onclick="() => StartEdit(task)">
                                    Edit
                                </button>

                                <button class="btn btn-sm btn-delete"
                                        disabled="@isBusy"
                                        @onclick="() => AskDelete(task)">
                                    Delete
                                </button>
                            </div>
                        }

                        @if (deleteConfirmationId == task.Id)
                        {
                            <div class="delete-confirm">
                                <span>Delete this task?</span>

                                <button class="btn btn-sm btn-delete"
                                        disabled="@isBusy"
                                        @onclick="() => ConfirmDelete(task)">
                                    Yes, delete
                                </button>

                                <button class="btn btn-sm btn-light"
                                        disabled="@isBusy"
                                        @onclick="CancelDelete">
                                    Cancel
                                </button>
                            </div>
                        }
                    </article>
                }
            </div>

            @if (!FilteredTasks.Any())
            {
                <div class="filter-empty">
                    No @activeFilter.ToLowerInvariant() tasks found.
                </div>
            }
        }
    </section>

    <footer class="dashboard-footer">
        <span>SmartTask</span>
        <span>Small steps. Big progress.</span>
    </footer>

</div>

<style>
