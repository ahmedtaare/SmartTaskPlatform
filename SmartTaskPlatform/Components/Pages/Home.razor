    }

    .priority-high {
        background: #ffebeb;
        color: #bd4242;
    }

    .status-text {
        color: #778198;
    }

    .status-done {
        color: #168655;
    }

    .task-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .btn-edit {
        border: 1px solid #e0e5ef;
        background: white;
        color: #5369e8;
    }

        .btn-edit:hover {
