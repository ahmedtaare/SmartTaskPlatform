        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes toast-enter {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 760px) {
        .dashboard {
            padding: 24px 14px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .stat-card {
            padding: 15px;
        }

        .create-form {
            grid-template-columns: 1fr;
        }

            .create-form .btn-create {
                width: 100%;
            }

        .task-panel {
            padding: 18px;
        }

        .section-heading {
            align-items: flex-start;
        }

        .task-row {
            align-items: flex-start;
            gap: 10px;
        }

        .task-actions {
            flex-direction: row;
        }

        .edit-fields {
            grid-template-columns: 1fr;
        }

        .api-status {
            font-size: .72rem;
            padding: 7px 9px;
        }

        .filter-btn {
            padding: 8px 10px;
        }

        .delete-confirm {
            align-items: stretch;
        }

            .delete-confirm span {
                flex-basis: 100%;
            }

        .dashboard-footer {
            flex-wrap: wrap;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .app-toast,
        .stat-card,
        .filter-btn {
            animation: none;
            transition: none;
        }
    }
</style>

@code {
    private List<TaskItem> tasks = new();

    private string newTitle = string.Empty;
    private string newPriority = "Medium";

    private string editTitle = string.Empty;
    private string editPriority = "Medium";

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string activeFilter = "All";

    private int? editingTaskId;
    private int? deleteConfirmationId;

    private bool isLoading = true;
    private bool isBusy;
    private bool apiConnected;

    private IEnumerable<TaskItem> FilteredTasks =>
        activeFilter switch
        {
            "Pending" => tasks.Where(t => !t.IsCompleted)
                              .OrderBy(t => t.Id),

            "Completed" => tasks.Where(t => t.IsCompleted)
                                .OrderBy(t => t.Id),

            _ => tasks.OrderBy(t => t.IsCompleted)
                      .ThenBy(t => t.Id)
        };

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        isLoading = true;

        try
        {
            tasks = await Api.GetAllAsync();
            apiConnected = true;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            apiConnected = false;
            errorMessage = $"Could not load tasks: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }

    private async Task ShowSuccess(string message)
    {
        successMessage = message;
        await Task.Delay(3000);

        await InvokeAsync(() =>
        {
            if (successMessage == message)
            {
                successMessage = string.Empty;
                StateHasChanged();
            }
        });
    }

    private void DismissSuccess()
    {
        successMessage = string.Empty;
    }

    private void DismissError()
    {
        errorMessage = string.Empty;
    }

    private async Task AddTask()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(newTitle) ||
            newTitle.Trim().Length < 3)
        {
            errorMessage = "Task title must contain at least 3 characters.";
            return;
        }

        isBusy = true;

        try
        {
            var created = await Api.CreateAsync(
                newTitle.Trim(),
                newPriority);

            if (created is not null)
            {
                newTitle = string.Empty;
                newPriority = "Medium";

                await LoadTasks();

                if (apiConnected)
                {
                    await ShowSuccess("Task created successfully.");
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not create task: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartEdit(TaskItem task)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        editingTaskId = task.Id;
        editTitle = task.Title;
        editPriority = task.Priority;

        deleteConfirmationId = null;
    }

    private async Task SaveEdit(TaskItem task)
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(editTitle) ||
            editTitle.Trim().Length < 3)
        {
            errorMessage = "Task title must contain at least 3 characters.";
            return;
        }

        isBusy = true;

        try
        {
            var updated = await Api.UpdateAsync(
                task.Id,
                editTitle.Trim(),
                editPriority,
                task.IsCompleted);

            if (updated is not null)
            {
                CancelEdit();
                await LoadTasks();

                if (apiConnected)
                {
                    await ShowSuccess("Task updated successfully.");
                }
            }
            else
            {
                errorMessage = "Task was not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not update task: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CancelEdit()
    {
        editingTaskId = null;
        editTitle = string.Empty;
        editPriority = "Medium";
    }

    private async Task ToggleComplete(TaskItem task)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        isBusy = true;

        try
        {
            var updated = await Api.UpdateAsync(
                task.Id,
                task.Title,
                task.Priority,
                !task.IsCompleted);

            if (updated is not null)
            {
                await LoadTasks();

                if (apiConnected)
                {
                    await ShowSuccess(
                        updated.IsCompleted
                            ? "Task marked as completed."
                            : "Task marked as pending.");
                }
            }
            else
            {
                errorMessage = "Task was not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not update task status: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AskDelete(TaskItem task)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        deleteConfirmationId = task.Id;
    }

    private void CancelDelete()
    {
        deleteConfirmationId = null;
    }

    private async Task ConfirmDelete(TaskItem task)
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;

        isBusy = true;

        try
        {
            await Api.DeleteAsync(task.Id);

            deleteConfirmationId = null;

            if (editingTaskId == task.Id)
            {
                CancelEdit();
            }

            await LoadTasks();

            if (apiConnected)
            {
                await ShowSuccess("Task deleted successfully.");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete task: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string GetPriorityClass(string priority) =>
        priority.ToLowerInvariant() switch
        {
            "low" => "priority-low",
            "high" => "priority-high",
            _ => "priority-medium"
        };
}
