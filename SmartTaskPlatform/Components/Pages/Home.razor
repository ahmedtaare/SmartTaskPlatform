    .delete-confirm {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 13px;
        border: 1px solid #f1dddd;
        border-radius: 12px;
        background: #fff8f8;
        color: #8f3434;
    }

        .delete-confirm span {
            flex: 1;
            min-width: 130px;
            font-size: .9rem;
            font-weight: 650;
        }

    .empty-state {
        padding: 38px 12px;
        text-align: center;
        border-top: 1px solid #edf0f5;
    }

    .empty-icon {
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        margin: 0 auto 14px;
        border-radius: 18px;
