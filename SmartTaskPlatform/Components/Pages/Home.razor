    }

        .btn-delete:hover {
            background: #fff0f0;
            color: #a32d2d;
        }

    .edit-form {
        width: 100%;
    }

    .edit-fields {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 170px;
        gap: 14px;
        margin-bottom: 14px;
    }

    .app-toast {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px 15px;
        margin-bottom: 18px;
        border: 1px solid transparent;
        border-radius: 12px;
        animation: toast-enter .2s ease-out;
    }

    .success-toast {
        background: #edfaf3;
        color: #176b45;
        border-color: #c8efd9;
    }

    .error-toast {
